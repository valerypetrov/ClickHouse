-- rate over series which never overlap
[('job','j')]	[('1970-01-01 00:02:40.000',0.1),('1970-01-01 00:17:40.000',1)]
-- unary minus over series which never overlap
[('job','j')]	[('1970-01-01 00:02:40.000',-7),('1970-01-01 00:04:20.000',-7),('1970-01-01 00:06:00.000',-7),('1970-01-01 00:17:40.000',-70)]
-- label_replace over series which never overlap
[('__name__','x'),('job','j')]	[('1970-01-01 00:02:40.000',7),('1970-01-01 00:04:20.000',7),('1970-01-01 00:06:00.000',7),('1970-01-01 00:17:40.000',70)]
-- instant query, one of the series has no value at this step
[('job','m')]	1970-01-01 00:02:40.000	0.1
-- binary operator, the side "one" has series which never overlap
[('job','j')]	[('1970-01-01 00:02:40.000',7.5),('1970-01-01 00:04:20.000',7.5),('1970-01-01 00:06:00.000',7.5),('1970-01-01 00:17:40.000',70.5)]
-- binary operator, the result has series which never overlap
[('job','j')]	[('1970-01-01 00:02:40.000',7.5),('1970-01-01 00:04:20.000',7.5),('1970-01-01 00:06:00.000',7.5),('1970-01-01 00:17:40.000',70.5)]
-- series which overlap
-- still an error: the result takes the tags of each series on the side "one", so they are not merged
-- group_left with `or on` on the side "one"
[('__name__','node_cpu'),('instance','abc'),('job','node'),('mode','idle'),('target','a@b.com')]	1970-01-01 00:01:00.000	3
[('__name__','node_cpu'),('instance','abc'),('job','node'),('mode','user'),('target','a@b.com')]	1970-01-01 00:01:00.000	1
[('__name__','node_cpu'),('instance','def'),('job','node'),('mode','idle')]	1970-01-01 00:01:00.000	8
[('__name__','node_cpu'),('instance','def'),('job','node'),('mode','user')]	1970-01-01 00:01:00.000	2
